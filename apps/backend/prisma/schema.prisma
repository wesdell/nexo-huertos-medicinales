// Nexo - Huertos Medicinales Comunitarios (v2: modelo acordado con el MSP el 06/11/2026)
// Requiere Prisma 6 (NO usar Prisma 7: ya no admite `url` dentro del schema).
// Los enums se replican en packages/shared/src/enums.ts (una prueba verifica que coincidan).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═════════════════════════ ENUMS ═════════════════════════

enum Rol {
  RESPONSABLE // único que registra datos de su huerto
  TECNICO_MSP // aprueba solicitudes, valida evidencias, modera el foro
  ADMIN       // respaldos, cuentas de técnicos y soporte
}

enum NivelMiembro {
  APRENDIZ
  OFICIAL
  MAESTRO
}

enum Genero {
  FEMENINO
  MASCULINO
  OTRO
  PREFIERO_NO_DECIR
}

enum Region {
  SIERRA
  COSTA
  AMAZONIA
  GALAPAGOS
}

enum FaseLunar {
  LUNA_NUEVA
  CRECIENTE
  LLENA
  MENGUANTE
}

enum TipoActividad {
  PREPARACION_TIERRA
  ESTRUCTURA_SIEMBRA
  RITUAL_SIEMBRA
  SIEMBRA
  SENALETICA
  CUIDADO_CRECIMIENTO
  RIEGO
  BANO_PREVIO_COSECHA
  RITUAL_GRATITUD
  COSECHA
  LIMPIEZA
  SECADO
  EMPAQUETADO
}

enum TipoDiseno {
  EN_TIERRA
  VERTICAL
  COLGANTE
  EN_PISO
}

enum VarianteDiseno {
  SURCO
  CAMADA
  CAMELLON
  TERRAZA
  PARED
  TECHO
  MACETERO
  BOTELLA
  LLANTA_PATIO
  TERRAZA_PISO
  GRADA
  BALCON
  FILO_VENTANA
}

enum TipoCerca {
  VIVA
  MATERIAL_NATURAL
  MATERIAL_RECICLADO
  METALICA
  CONVENCIONAL
}

enum TipoSuelo {
  ARCILLOSO
  LIMOSO
  ARENOSO
  MARGOSO
  GREDOSO
  PANTANOSO
}

enum TipoAgua {
  RIO
  CANAL
  GOTEO
  OTRO
}

enum TipoAbono {
  BARBECHO
  RESTOS_VEGETALES
  HOJA
  COMPOST
}

enum CicloPlanta {
  CORTO
  LARGO
}

enum CualidadPlanta {
  CALIENTE
  FRIA
}

enum EspacioBodega {
  HERRAMIENTAS
  SEMILLAS_PLANTULAS
  ABONOS
}

enum TipoArchivo {
  FOTO
  VIDEO
}

enum EstadoSolicitud {
  PENDIENTE
  APROBADA
  RECHAZADA
}

enum EstadoCiclo {
  ACTIVO
  COMPLETADO
  FALLIDO
}

enum EstadoEvidencia {
  PENDIENTE
  APROBADA
  RECHAZADA
  SIN_EVIDENCIA
}

enum CausaFracaso {
  HELADA
  SEQUIA
  EXCESO_LLUVIA
  PLAGA
  ENFERMEDAD
  ANIMALES
  DESCUIDO
  ROBO_DANO
  OTRA
}

enum CategoriaAporte {
  PRACTICAS
  SABERES
  SENTIRES
}

// ═════════════════════════ GEOGRAFÍA ═════════════════════════

model Provincia {
  id          Int               @id
  nombre      String            @unique
  region      Region
  parroquias  Parroquia[]
  huertos     Huerto[]
  solicitudes SolicitudHuerto[]

  @@map("provincias")
}

model Parroquia {
  id          Int               @id
  nombre      String
  provinciaId Int
  provincia   Provincia         @relation(fields: [provinciaId], references: [id])
  huertos     Huerto[]
  solicitudes SolicitudHuerto[]

  @@unique([provinciaId, nombre])
  @@map("parroquias")
}

// ═════════════════════════ CUENTAS ═════════════════════════

/// Solo tienen cuenta el responsable de huerto, el técnico del MSP y el administrador.
/// Los voluntarios no tienen cuenta: los registra el responsable (modelo Voluntario).
model Usuario {
  id               String   @id @default(uuid())
  nombre           String
  email            String   @unique
  cedula           String?  @unique
  celular          String?
  passwordHash     String
  rol              Rol
  /// La clave inicial llega por correo y debe cambiarse en el primer ingreso.
  debeCambiarClave Boolean  @default(false)
  activo           Boolean  @default(true)
  /// Consentimiento LOPDP (se acepta al enviar la solicitud de huerto).
  consentimientoDatosEn DateTime?
  versionPolitica       String?
  creadoEn         DateTime @default(now())

  huertos          Huerto[]               @relation("Responsable")
  historial        HistorialResponsable[]
  actividades      Actividad[]            @relation("RegistradaPor")
  revisiones       Actividad[]            @relation("RevisadaPor")
  solicitudesRevisadas SolicitudHuerto[]
  aportes          Aporte[]               @relation("AutorAporte")
  aportesRetirados Aporte[]               @relation("RetiradoPor")

  @@map("usuarios")
}

// ═════════════════════════ SOLICITUD Y HUERTO ═════════════════════════

/// Formulario público «Solicitar crear huerto». El MSP contacta a la persona fuera del sistema y decide.
model SolicitudHuerto {
  id                String          @id @default(uuid())
  nombreHuerto      String
  tipo              TipoDiseno
  subtipos          VarianteDiseno[]
  provinciaId       Int
  parroquiaId       Int
  direccion         String?
  latitud           Decimal         @db.Decimal(9, 6)
  longitud          Decimal         @db.Decimal(9, 6)
  altitud           Int             // msnm, para filtrar plantas del catálogo
  nombreResponsable String
  cedula            String
  email             String
  celular           String
  consentimientoDatosEn DateTime
  versionPolitica   String
  estado            EstadoSolicitud @default(PENDIENTE)
  motivo            String?         // obligatorio al rechazar
  revisadaPorId     String?
  revisadaEn        DateTime?
  huertoId          String?         @unique
  creadaEn          DateTime        @default(now())

  provincia         Provincia       @relation(fields: [provinciaId], references: [id])
  parroquia         Parroquia       @relation(fields: [parroquiaId], references: [id])
  revisadaPor       Usuario?        @relation(fields: [revisadaPorId], references: [id])
  huerto            Huerto?         @relation(fields: [huertoId], references: [id])

  @@index([estado, creadaEn])
  @@map("solicitudes_huerto")
}

/// El huerto es la comunidad de siembra: un responsable a la vez y de 0 a n voluntarios.
model Huerto {
  id            String           @id @default(uuid())
  nombre        String
  tipo          TipoDiseno
  /// Hasta 3 subtipos (surcos, vertical, macetas…) con el mismo responsable y voluntarios.
  subtipos      VarianteDiseno[]
  responsableId String
  activo        Boolean          @default(true)

  provinciaId   Int
  parroquiaId   Int
  direccion     String?
  latitud       Decimal          @db.Decimal(9, 6)
  longitud      Decimal          @db.Decimal(9, 6)
  altitud       Int

  // Información operativa (la completa el responsable después de la aprobación)
  tipoCerca     TipoCerca?
  materialCerca String?
  areaM2        Decimal?         @db.Decimal(10, 2)
  tipoSuelo     TipoSuelo?
  tipoAgua      TipoAgua?
  detalleAgua   String?
  tipoAbono     TipoAbono?

  puntosTotales      Int         @default(0) // caché; fuente de verdad: MovimientoPuntos
  ultimoCambioPuntos DateTime?               // desempate del ranking
  creadoEn      DateTime         @default(now())

  responsable   Usuario          @relation("Responsable", fields: [responsableId], references: [id])
  provincia     Provincia        @relation(fields: [provinciaId], references: [id])
  parroquia     Parroquia        @relation(fields: [parroquiaId], references: [id])
  solicitud     SolicitudHuerto?
  historial     HistorialResponsable[]
  voluntarios   VoluntarioHuerto[]
  plantas       HuertoPlanta[]
  plantasPropuestas Planta[]
  ciclos        Ciclo[]
  actividades   Actividad[]
  bodega        BodegaItem[]
  movimientos   MovimientoPuntos[]
  solicitudesNivel SolicitudNivel[]

  @@index([tipo, puntosTotales(sort: Desc)])
  @@map("huertos")
}

model HistorialResponsable {
  id        String    @id @default(uuid())
  huertoId  String
  usuarioId String
  desde     DateTime  @default(now())
  hasta     DateTime?
  motivo    String?

  huerto    Huerto    @relation(fields: [huertoId], references: [id], onDelete: Cascade)
  usuario   Usuario   @relation(fields: [usuarioId], references: [id])

  @@index([huertoId])
  @@map("historial_responsables")
}

// ═════════════════════════ VOLUNTARIOS (sin cuenta) ═════════════════════════

/// Un voluntario puede estar en varios huertos y vivir en cualquier lugar. Se identifica por cédula si la tiene.
model Voluntario {
  id              String       @id @default(uuid())
  nombre          String
  cedula          String?      @unique
  fechaNacimiento DateTime     @db.Date
  genero          Genero
  /// Lo sube el sistema automáticamente; un nivel inicial mayor lo aprueba el MSP.
  nivel           NivelMiembro @default(APRENDIZ)
  horasValidadas  Decimal      @default(0) @db.Decimal(8, 1) // caché
  puntos          Int          @default(0)                   // caché
  creadoEn        DateTime     @default(now())

  huertos         VoluntarioHuerto[]
  participaciones Participacion[]
  movimientos     MovimientoPuntos[]
  solicitudesNivel SolicitudNivel[]

  @@map("voluntarios")
}

model VoluntarioHuerto {
  voluntarioId String
  huertoId     String
  activo       Boolean    @default(true)
  desde        DateTime   @default(now())

  voluntario   Voluntario @relation(fields: [voluntarioId], references: [id], onDelete: Cascade)
  huerto       Huerto     @relation(fields: [huertoId], references: [id], onDelete: Cascade)

  @@id([voluntarioId, huertoId])
  @@index([huertoId])
  @@map("voluntarios_huerto")
}

/// El responsable pide que un voluntario con experiencia entre como Oficial o Maestro; el MSP decide.
model SolicitudNivel {
  id            String          @id @default(uuid())
  voluntarioId  String
  huertoId      String
  nivel         NivelMiembro
  justificacion String
  estado        EstadoSolicitud @default(PENDIENTE)
  motivo        String?
  creadaEn      DateTime        @default(now())
  revisadaEn    DateTime?

  voluntario    Voluntario      @relation(fields: [voluntarioId], references: [id], onDelete: Cascade)
  huerto        Huerto          @relation(fields: [huertoId], references: [id], onDelete: Cascade)

  @@index([estado])
  @@map("solicitudes_nivel")
}

// ═════════════════════════ CATÁLOGO DE PLANTAS (MSP) ═════════════════════════

/// Catálogo global que precarga y administra el MSP. Solo plantas medicinales.
/// Un responsable puede proponer una planta nueva (estado PENDIENTE) y el MSP la analiza.
model Planta {
  id               String          @id @default(uuid())
  nombreComun      String
  nombreCientifico String
  otrosNombres     String[]
  familiaBotanica  String?
  altitudMin       Int?
  altitudMax       Int?
  provincias       String[]
  ciclo            CicloPlanta
  cualidad         CualidadPlanta
  usosMedicinales  String
  parteUsada       String?
  dosificacion     String?
  contraindicaciones String?
  fotoUrl          String?
  estado           EstadoSolicitud @default(APROBADA)
  motivo           String?
  propuestaPorId   String?         // huerto que la propuso
  creadaEn         DateTime        @default(now())

  propuestaPor     Huerto?         @relation(fields: [propuestaPorId], references: [id])
  huertos          HuertoPlanta[]
  ciclos           Ciclo[]

  @@unique([nombreCientifico])
  @@index([estado])
  @@map("plantas")
}

model HuertoPlanta {
  huertoId       String
  plantaId       String
  /// El responsable confirmó una planta fuera del rango de altitud («¿está seguro?»).
  fueraDeAltitud Boolean  @default(false)
  desde          DateTime @default(now())

  huerto         Huerto   @relation(fields: [huertoId], references: [id], onDelete: Cascade)
  planta         Planta   @relation(fields: [plantaId], references: [id])

  @@id([huertoId, plantaId])
  @@map("huerto_plantas")
}

// ═════════════════════════ CICLOS Y ACTIVIDADES ═════════════════════════

/// Las plantas de un mismo tipo se siembran y cosechan juntas: un ciclo por planta.
/// Si la cosecha se daña, el ciclo queda FALLIDO con su causa y se empieza otro.
model Ciclo {
  id            String        @id @default(uuid())
  huertoId      String
  plantaId      String
  estado        EstadoCiclo   @default(ACTIVO)
  causaFracaso  CausaFracaso?
  justificacion String?
  iniciadoEn    DateTime      @default(now())
  cerradoEn     DateTime?

  huerto        Huerto        @relation(fields: [huertoId], references: [id], onDelete: Cascade)
  planta        Planta        @relation(fields: [plantaId], references: [id])
  actividades   Actividad[]

  @@index([huertoId, estado])
  @@map("ciclos")
}

/// Un paso del ciclo, registrado después de hacerlo. Los puntos se otorgan cuando el MSP aprueba la evidencia.
model Actividad {
  id              String          @id @default(uuid())
  huertoId        String
  cicloId         String
  registradaPorId String
  tipo            TipoActividad
  fecha           DateTime        @db.Date
  hora            String?
  faseLunar       FaseLunar?
  detalle         Json
  /// Códigos de advertencia que el responsable confirmó; vacío = siguió el calendario (bono).
  advertencias    String[]
  /// false = paso saltado (no cumplido): 0 puntos.
  cumplida        Boolean         @default(true)
  estadoEvidencia EstadoEvidencia @default(PENDIENTE)
  intento         Int             @default(1)
  motivoRechazo   String?
  revisadaPorId   String?
  revisadaEn      DateTime?
  puntosOtorgados Int             @default(0)
  creadaEn        DateTime        @default(now())

  huerto          Huerto          @relation(fields: [huertoId], references: [id], onDelete: Cascade)
  ciclo           Ciclo           @relation(fields: [cicloId], references: [id], onDelete: Cascade)
  registradaPor   Usuario         @relation("RegistradaPor", fields: [registradaPorId], references: [id])
  revisadaPor     Usuario?        @relation("RevisadaPor", fields: [revisadaPorId], references: [id])

  participaciones Participacion[]
  archivos        ArchivoActividad[]
  paquete         Paquete?
  movimientos     MovimientoPuntos[]

  @@index([huertoId, fecha])
  @@index([cicloId])
  @@index([estadoEvidencia, creadaEn])
  @@map("actividades")
}

/// Qué voluntarios hicieron la actividad y cuántas horas (máximo 24 por día).
model Participacion {
  actividadId  String
  voluntarioId String
  horas        Decimal    @db.Decimal(4, 1)

  actividad    Actividad  @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  voluntario   Voluntario @relation(fields: [voluntarioId], references: [id])

  @@id([actividadId, voluntarioId])
  @@index([voluntarioId])
  @@map("participaciones")
}

/// Evidencia: fotos o videos reales del huerto. Cada intento sube sus propios archivos.
model ArchivoActividad {
  id          String      @id @default(uuid())
  actividadId String
  intento     Int         @default(1)
  tipo        TipoArchivo
  url         String
  nombre      String
  mime        String
  bytes       Int
  creadoEn    DateTime    @default(now())

  actividad   Actividad   @relation(fields: [actividadId], references: [id], onDelete: Cascade)

  @@index([actividadId])
  @@map("archivos_actividad")
}

/// Producción: paquetes etiquetados de planta seca. El financiamiento depende de este histórico.
model Paquete {
  id                 String         @id @default(uuid())
  actividadId        String         @unique
  cantidad           Int
  indicacionesUso    String
  dosificacion       String
  contraindicaciones String
  fechaEmpaquetado   DateTime       @db.Date
  fechaCaducidad     DateTime       @db.Date
  cualidad           CualidadPlanta

  actividad          Actividad      @relation(fields: [actividadId], references: [id], onDelete: Cascade)

  @@map("paquetes")
}

// ═════════════════════════ BODEGA ═════════════════════════

model BodegaItem {
  id         String        @id @default(uuid())
  huertoId   String
  espacio    EspacioBodega
  nombre     String
  cantidad   Decimal       @db.Decimal(10, 2)
  unidad     String
  nota       String?
  actualizadoEn DateTime   @updatedAt

  huerto     Huerto        @relation(fields: [huertoId], references: [id], onDelete: Cascade)

  @@index([huertoId])
  @@map("bodega_items")
}

// ═════════════════════════ PUNTOS ═════════════════════════

/// Libro de puntos: toda acreditación queda registrada. Los totales de voluntario y huerto son cachés.
model MovimientoPuntos {
  id           String     @id @default(uuid())
  voluntarioId String
  huertoId     String
  actividadId  String?
  puntos       Int
  horas        Decimal    @db.Decimal(4, 1)
  creadoEn     DateTime   @default(now())

  voluntario   Voluntario @relation(fields: [voluntarioId], references: [id])
  huerto       Huerto     @relation(fields: [huertoId], references: [id], onDelete: Cascade)
  actividad    Actividad? @relation(fields: [actividadId], references: [id], onDelete: Cascade)

  @@index([huertoId, creadoEn])
  @@index([voluntarioId])
  @@map("movimientos_puntos")
}

// ═════════════════════════ FORO ═════════════════════════

model Aporte {
  id            String          @id @default(uuid())
  autorId       String
  padreId       String?         // respuesta a otro aporte
  categoria     CategoriaAporte
  titulo        String?
  contenido     String
  reportes      Int             @default(0)
  retirado      Boolean         @default(false)
  motivoRetiro  String?
  retiradoPorId String?
  retiradoEn    DateTime?
  creadoEn      DateTime        @default(now())

  autor         Usuario         @relation("AutorAporte", fields: [autorId], references: [id])
  retiradoPor   Usuario?        @relation("RetiradoPor", fields: [retiradoPorId], references: [id])
  padre         Aporte?         @relation("Respuestas", fields: [padreId], references: [id], onDelete: Cascade)
  respuestas    Aporte[]        @relation("Respuestas")

  @@index([creadoEn(sort: Desc)])
  @@index([padreId])
  @@map("aportes")
}
